{
  "name": "sales-management-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx migrate.ts",
    "backup": "tsx backup/backup.ts",
    "restore": "tsx backup/restore.ts",
    "provision:admin": "tsx security/provision.ts",
    "import:legacy": "tsx import/legacyImport.ts",
    "seed:dev": "tsx seed-dev.ts",
    "test": "node --import tsx --test tests/"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.8.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
